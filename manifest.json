{
  "manifest_version": 3,
  "name": "Tumblr Likes Calendar",
  "version": "0.1.0",
  "description": "Aggiunge alla pagina dei Like di Tumblr un calendario heatmap dei tuoi \u201cmi piace\u201d. Clicca un giorno per saltare ai like di quella data.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tumblr-likes-calendar@local.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.tumblr.com/*"],
      "js": ["likes-calendar.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
