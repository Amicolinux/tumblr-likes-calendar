{
  "manifest_version": 3,
  "name": "Tumblr Likes Calendar",
  "version": "0.1.2",
  "description": "Adds a heatmap calendar of your likes to the Tumblr Likes page. Click a day to jump to the likes from that date.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tumblr-likes-calendar@local.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.tumblr.com/*"],
      "js": ["likes-calendar.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
